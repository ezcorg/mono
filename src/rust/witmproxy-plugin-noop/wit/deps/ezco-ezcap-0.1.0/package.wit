package ezco:ezcap@0.1.0;

/// The shared vocabulary for requesting and scoping capabilities.
///
/// A host (icanhaz, witmproxy) exposes capabilities as WIT interfaces and
/// resources. A guest (a plugin, an agent) asks for one by `kind` and proposes
/// a `scope`. The host mints an *instance* whose scope is the guest's proposal
/// conjoined with whatever the user (or a share bundle, or an intermediate
/// broker) adds. Narrowing only ever appends: a child instance's clauses are
/// `parent && extra`. No party edits an expression, so containment is
/// syntactic and checking a chain is reading it.
///
/// Both scope fields are CEL. The environment each interface offers to them
/// (`call.*`, `event`, `caller.*`, `state.*`, `time`) is generated from that
/// interface's WIT and documented beside it. A clause that names an argument
/// a method does not have fails to compile at load time; a clause that names
/// a variable the host did not bind evaluates to `false`, so scopes fail
/// closed.
interface types {
    /// How a capability may be used.
    record scope {
        /// Evaluated once per event, with the event bound: should the holder
        /// run at all. `"true"` for capabilities that are not event-driven.
        when: string,
        /// Evaluated per call on the minted resource, with `call.method`,
        /// `call.args.*`, the current event, `caller.*`, `state.*` and `time`
        /// bound: may this call proceed. `call.method` distinguishes methods,
        /// so there is no per-method list.
        allow: string,
    }

    /// A request for (or a description of) one capability.
    ///
    /// `kind` names a WIT interface, resource or method by path:
    /// `icanhaz:nocap/fs`, `witmproxy:plugin/capabilities.local-storage-client`,
    /// `icanhaz:nocap/process@0.1.0.spawn`.
    record capability {
        kind: string,
        scope: scope,
    }

    /// Why a call on a capability did not proceed.
    variant capability-error {
        /// The capability was never granted (or has been revoked).
        unavailable,
        /// Granted, but this call fell outside `allow`. Carries the scope
        /// rendered as a sentence, for the guest to show or log.
        denied(string),
    }
}
