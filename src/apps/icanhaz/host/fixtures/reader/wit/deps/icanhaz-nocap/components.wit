package icanhaz:nocap@0.1.0;

/// The component store: capability components, content-addressed. A
/// component is code, not authority: anyone may add one (it is validated,
/// hashed and kept), and linking it to a provider is a grant decided
/// elsewhere. Validation is the Tier 3 rule: every import must be a
/// capability interface (`wasi:*`, `icanhaz:nocap/*`, `ezco:ezcap/*`); a library import is refused with the hint to compose it
/// in at build time; the exports must satisfy a capability interface too.
interface components {
  /// Where a component came from, as its author states it. Recorded when
  /// supplied; `reproducible` becomes true only once a rebuild from it
  /// matched the hash. Local work may add components without it; publishing
  /// or vetting is where it becomes a requirement.
  record provenance {
    /// A repository or URL.
    source: string,
    /// A commit, tag or content hash within it.
    revision: option<string>,
    /// The command that produced the bytes.
    build: option<string>,
    /// The toolchain or container image, by name or hash.
    builder: option<string>,
  }

  record component-info {
    /// `sha256:<hex>` of the bytes: the name everything refers to it by.
    hash: string,
    /// The world or package name the component declares, if any.
    name: option<string>,
    size: u64,
    /// Qualified interface names (`wasi:filesystem/types@0.2.12`).
    imports: list<string>,
    exports: list<string>,
    /// Unix seconds.
    added: u64,
    provenance: option<provenance>,
    reproducible: bool,
  }

  add: func(bytes: list<u8>, provenance: option<provenance>) -> result<component-info, string>;
  /// Fetch a component from a source and add it. A source is an OCI
  /// reference, `oci://<registry>/<name>[:<tag>|@<digest>]`, or a component
  /// another daemon holds, `iroh:<key>?addr=…#sha256:<hex>`. The bytes are
  /// verified against the digest they were announced under before the store
  /// keeps them, and the provenance records the source and that digest; a
  /// tag is resolved once and forgotten, so an updated tag is a new
  /// component. Fetching grants nothing: the component sits inert until a
  /// grant names it.
  fetch: func(source: string) -> result<component-info, string>;
  all: func() -> list<component-info>;
  get: func(hash: string) -> result<list<u8>, string>;
  /// Local hosts only.
  remove: func(hash: string) -> result<bool, string>;

  /// A component this daemon's registry serves, when one is served: pulled
  /// as `oci://<registry bind>/<name>:<tag>` by anyone holding the registry
  /// credential.
  record publication {
    /// `<name>:<tag>`.
    reference: string,
    /// The manifest digest a pull by tag resolves to.
    digest: string,
    /// The component's hash: the manifest's one layer.
    hash: string,
  }
  /// Publish a held component under `reference` (`<name>:<tag>`) in this
  /// daemon's registry. The manifest is generated once, so the digest is
  /// stable until the tag is published again. Local hosts only.
  publish: func(hash: string, reference: string) -> result<publication, string>;
  /// Forget a tag; the component stays in the store. Local hosts only.
  unpublish: func(reference: string) -> result<bool, string>;
  published: func() -> list<publication>;
}

world components-wrpc {
  import components;
  export components;
}
