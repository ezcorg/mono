package icanhaz:nocap@0.1.0;

/// The object-capability + consent surface (icanhaz). NoCap governs *authority*;
/// the claimed resource governs *use*.
interface broker {
  use wasi:io/poll@0.2.0.{ pollable };
  use wasi:filesystem/types@0.2.0.{ descriptor };
  use types.{ principal, capability-kind, caveat, denied, grant-info };
  use runtime.{ terminal, process-host };
  use mediation.{ selection };

  /// Unforgeable, attenuable, revocable handle. You can't conjure one — only be
  /// granted one — which is how "no ambient authority" is enforced by the types.
  resource capability {
    info: func() -> grant-info;
    /// Strictly-narrower child (macaroon caveats). Never widens.
    attenuate: func(caveats: list<caveat>) -> result<capability, denied>;
    /// Third-party handoff: hand a narrowed copy to another principal.
    delegate:  func(to: principal, caveats: list<caveat>) -> result<capability, denied>;
    /// Drop authority now — revokes this handle and everything delegated from it.
    revoke:    func();

    /// Turn the grant into its concrete resource. Exactly one matches the
    /// granted kind; from here you just speak plain WASI.
    claim-terminal:     func() -> result<terminal, denied>;
    claim-process-host: func() -> result<process-host, denied>;
    claim-filesystem:   func() -> result<descriptor, denied>;
  }

  /// A pending consent prompt. Resolves once the human approves/rejects in
  /// icanhaz. (Preview 2 poll shape; Preview 3 ⇒ `future<result<capability, denied>>`.)
  resource grant-request {
    subscribe: func() -> pollable;
    /// `none` until decided; `some` exactly once thereafter.
    get: func() -> option<result<capability, denied>>;
  }

  /// The authenticated link to a provider, over your tailnet.
  resource session {
    principal: func() -> principal;
    /// Ask for authority — this *is* the consent prompt. `via` is how the user
    /// chose to mediate it (a parameterised attenuator, or a policy component).
    /// The dialog lets them narrow the scope / pick a policy before granting.
    request: func(want: capability-kind, reason: string, via: selection) -> grant-request;
    /// Re-acquire a still-valid durable grant without re-prompting.
    resume:  func(grant-id: string) -> result<capability, denied>;
    /// What this principal currently holds — for the app UI + audit view.
    granted: func() -> list<grant-info>;
  }
}

/// Linked into markdown-editor's nocap client (the browser / PWA). Its imports
/// are satisfied *remotely*, over wRPC, by a consented provider on your tailnet.
world client {
  import broker;
  import runtime;
  import wasi:io/streams@0.2.0;
  import wasi:io/poll@0.2.0;
}

/// Implemented by `icanhazd` on your machine and served over wRPC. It *exports*
/// the consent surface + the capability providers; how it fulfils them (host
/// shell, container, …) is its business.
world provider {
  export broker;
  export runtime;
}
