package icanhaz:nocap@0.1.0;

/// A deliberately tiny stand-in for `wasi:filesystem`, used to prove the policy
/// membrane end to end (host ⇄ wasmtime policy component ⇄ raw host capability,
/// served over wRPC) without implementing all ~30 methods of
/// `wasi:filesystem/types`. Once the engine is proven against this, the *same*
/// composition runs the real `world fs-policy` over `wasi:filesystem@0.2`.
interface fs-lite {
  /// Read a file's bytes, or an error message.
  read:  func(path: string) -> result<list<u8>, string>;
  /// Write bytes to a file (create/truncate).
  write: func(path: string, data: list<u8>) -> result<_, string>;
  /// List entry names directly under a directory.
  read-dir: func(dir: string) -> result<list<string>, string>;
}

/// Authoring world for a **walking-skeleton** filesystem policy: it imports the
/// raw host `fs-lite` (the authority) + a policy `context`, and exports the
/// mediated `fs-lite` the requestor sees — e.g. a path jail that audits every
/// access and escalates on writes outside the granted subtree. Same membrane
/// shape as `fs-policy`, minus the `wasi:filesystem` surface area.
world fs-lite-policy {
  import policy;
  import fs-lite;     // raw host fs-lite — the authority
  export fs-lite;     // the mediated view the grant exposes
}

/// The **consented** filesystem capability served over wRPC. Each call carries a
/// broker `grant`; the daemon validates it (a live `filesystem` grant) before
/// delegating to the policy membrane (`fs-lite`). Distinct from `fs-lite`, which
/// is the membrane's *internal* interface and never sees a grant.
interface fs {
  read:     func(grant: string, path: string) -> result<list<u8>, string>;
  write:    func(grant: string, path: string, data: list<u8>) -> result<_, string>;
  read-dir: func(grant: string, dir: string) -> result<list<string>, string>;
}

/// Loopback world for the native wRPC bridge: importing `fs` generates the
/// client stubs, exporting it the server Handler. The daemon serves the export
/// (validate grant → wasmtime policy composition); remote peers call the import.
world fs-wrpc {
  import fs;
  export fs;
}
