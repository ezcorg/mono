package icanhaz:nocap@0.1.0;

/// The consented execution environment the daemon exports. Process-shaped and
/// streaming; the `terminal` resource is the interactive PTY this feature
/// targets.
///
/// Preview 2 shape — async is the poll model (`wasi:io/poll` + `wasi:io/streams`).
/// Under Preview 3 the stream pairs collapse to `stream<u8>` and the
/// `subscribe`/`*-code` poll pairs become `future<…>`. See README.
interface runtime {
  use wasi:io/streams@0.2.0.{ input-stream, output-stream };
  use wasi:io/poll@0.2.0.{ pollable };
  use wasi:filesystem/types@0.2.0.{ descriptor };

  /// Spawn one-shot processes against a working filesystem.
  resource process-host {
    /// The filesystem processes see — itself a capability (memfs, an OPFS
    /// mount, or a host directory you were granted).
    root: func() -> descriptor;
    spawn: func(spec: process-spec) -> result<process, spawn-error>;
  }

  record process-spec {
    command: string,
    args: list<string>,
    env: list<tuple<string, string>>,
    cwd: option<string>,
  }

  resource process {
    stdin:  func() -> output-stream;
    stdout: func() -> input-stream;
    stderr: func() -> input-stream;
    signal: func(sig: signal);
    subscribe: func() -> pollable;          // ready when the process exits
    exit-code: func() -> option<s32>;       // none until it has exited
  }

  /// An interactive terminal (PTY). `stdin`/`stdout` are byte streams carried
  /// over wRPC; a codeblock wires them to an xterm.js view.
  resource terminal {
    stdin:  func() -> output-stream;         // keystrokes in
    stdout: func() -> input-stream;          // rendered output (the pty merges stderr)
    resize: func(cols: u16, rows: u16);
    signal: func(sig: signal);
    subscribe: func() -> pollable;
    exit-code: func() -> option<s32>;
  }

  enum signal { hup, int, quit, term, kill }

  variant spawn-error {
    unsupported(string),
    not-authorized,
    host-error(string),
  }
}
