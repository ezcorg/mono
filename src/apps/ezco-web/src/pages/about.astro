---
import RoomLayout from '../layouts/RoomLayout.astro';
import StaticPage from '../components/StaticPage.astro';
import Room from '../components/Room.astro';
import { sections, statementHtml, links } from '../data/about';
import { routes, roomRoute } from '../data/site';
const r = routes.find((r) => r.path === '/about')!;
---

<RoomLayout title={`${r.title} · ez co`} description={r.description} canonical="/about/" route={roomRoute('/about')}>
	<StaticPage title={r.title} current="/about">
		{sections.map((s) => (
			<section>
				<h2>{s.heading}</h2>
				<ul>{s.statements.map((st) => <li set:html={statementHtml(st, (h) => h + '/')} />)}</ul>
			</section>
		))}
		<p>Employee of the month: Lady. Find us on <a href={links.github}>GitHub</a> and <a href={links.linkedin}>LinkedIn</a>.</p>
	</StaticPage>
	<Room />
</RoomLayout>
