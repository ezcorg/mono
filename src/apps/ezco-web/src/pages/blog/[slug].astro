---
import RoomLayout from '../../layouts/RoomLayout.astro';
import StaticPage from '../../components/StaticPage.astro';
import Room from '../../components/Room.astro';
import { posts, fmtDate } from '../../data/posts';
import { SITE, roomRoute } from '../../data/site';

export function getStaticPaths() { return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } })); }
const { post } = Astro.props;
const { fm, Content } = post;
const jsonld = {
	'@context': 'https://schema.org', '@type': 'BlogPosting', headline: fm.title, description: fm.description, datePublished: fm.date,
	author: fm.author ? { '@type': 'Person', name: fm.author, ...(fm.authorUrl ? { url: fm.authorUrl } : {}) } : { '@type': 'Organization', name: 'ez co' },
	publisher: { '@type': 'Organization', name: 'ez co', url: SITE }, mainEntityOfPage: SITE + post.path, keywords: fm.tags?.join(', '),
};
---

<RoomLayout title={`${fm.title} · ez co`} description={fm.description} canonical={post.path} route={roomRoute(post.path)} type="article" published={fm.date} keywords={fm.tags} jsonld={jsonld}>
	<StaticPage title={fm.title} current="/blog">
		<p class="meta">{fmtDate(fm.date)}{fm.author && <> · {fm.authorUrl ? <a href={fm.authorUrl} rel="author">{fm.author}</a> : fm.author}</>}</p>
		<article><Content /></article>
		<p><a href="/blog/">← all posts</a></p>
	</StaticPage>
	<Room />
</RoomLayout>
