---
/* The codeblock demo in its own document, framed by the laptop's OS window (see src/room/demos.js). Not a page people visit. */
import '../../styles/global.css';
import '../../styles/ezos-frame.css';
import { projects } from '../../data/work';
const github = projects.find((p) => p.id === 'codeblock')!.github;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex" />
		<title>codeblock</title>
		<style is:global>
			html, body { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 14px; }
			#mount { display: flex; flex-direction: column; }
			#mount .cm-editor { flex: 1; min-height: 0; }
			/* the search toolbar is lifted out of the editor into the title bar; its empty panel row goes */
			#mount .cm-panels.cm-panels-top { display: none; }
		</style>
	</head>
	<body>
		<div id="mount"><div class="loading">loading…</div></div>
		<script is:inline define:vars={{ github }}>
			window.__ezosGithub = github;
		</script>
		<script>
			import { getDemoFs } from '../../scripts/demo-fs';
			import { frame } from '../../scripts/ezos-frame';
			const { tool } = frame({ github: (window as unknown as { __ezosGithub: string }).__ezosGithub });
			const el = document.getElementById('mount')!;
			(async () => {
				const fs = await getDemoFs();
				const { createCodeblock, SearchIndex } = await import('@joinezco/codeblock');
				const index = await SearchIndex.get(fs, '.codeblock/index.json');
				el.innerHTML = '';
				createCodeblock({ parent: el, fs, filepath: 'example.ts', index, cwd: '/', dark: true });
				/* the file-search toolbar is a CodeMirror panel; it is moved up into the title bar (and put back there if CodeMirror ever re-syncs its panels) */
				const lift = () => { const p = el.querySelector('.cm-panels-top .cm-toolbar-panel'); if (p) tool.appendChild(p); return !!p; };
				let tries = 0; const poll = () => { if (!lift() && tries++ < 300) requestAnimationFrame(poll); }; poll();
				new MutationObserver(() => { if (!tool.querySelector('.cm-toolbar-panel')) lift(); }).observe(el, { childList: true, subtree: true });
			})().catch((e) => { console.error(e); el.innerHTML = '<div class="loading">couldn\'t start codeblock</div>'; });
		</script>
	</body>
</html>
