---
/* The markdown-editor demo in its own document, framed by the laptop's OS window (see src/room/demos.js). Not a page people visit. */
import '../../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex" />
		<title>markdown-editor</title>
		<style>
			html, body { margin: 0; height: 100%; background: #1e1e1e; color: #f5f5f5; font-family: 'Source Serif 4', system-ui, serif; font-size: 14px; }
			#mount { position: absolute; inset: 0; overflow: auto; }
			#mount .ProseMirror { font-family: 'Source Serif 4', system-ui, Avenir, Helvetica, Arial, serif; }
			.loading { padding: 1em; opacity: .6; font: 12px ui-monospace, Menlo, monospace; }
		</style>
	</head>
	<body>
		<div id="mount"><div class="loading">loading…</div></div>
		<script>
			import { getDemoFs } from '../../scripts/demo-fs';
			const el = document.getElementById('mount')!;
			(async () => {
				const fs = await getDemoFs();
				const { createEditor } = await import('@joinezco/markdown-editor');
				el.innerHTML = '';
				const editor = createEditor({ element: el, autofocus: false, fs: { fs, filepath: 'hello.md', autoSave: true } });
				(editor.view.dom.closest('.ezco-mde') ?? editor.view.dom).setAttribute('data-theme', 'dark');
			})().catch((e) => { console.error(e); el.innerHTML = '<div class="loading">couldn\'t start markdown-editor</div>'; });
		</script>
	</body>
</html>
