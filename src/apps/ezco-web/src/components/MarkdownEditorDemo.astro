---
import Logo from "../components/Logo.astro";

// The footer (slotted into `DualColumnLayout`'s `footer` slot) is
// rendered by the consuming page, not by this component — `slot`
// attributes only resolve against the *immediate* parent component's
// named slots, and `MarkdownEditorDemo` itself has no footer slot.
---

<div class="demo-container bg-[#1e1e1e]">
    <!-- The left-gutter chrome — logo, file search, and document outline — lives
         in ONE <aside>, laid out with flex + gap (no per-element `top` math). The
         aside is `position: sticky` inside `.outline-col`, which spans the editor's
         height (before the footer); so the whole group sticks together while
         scrolling and is pushed up by the footer at the bottom of the page,
         rendering without overflowing into it. On desktop this aside renders its
         own logo (the layout's fixed logo is hidden); on narrower screens it
         falls back to a search-only bar at the top and the layout's logo shows. -->
    <div class="outline-col">
        <aside class="editor-aside">
            <div class="aside-logo"><Logo size={80} /></div>
            <div id="doc-toolbar"></div>
            <div id="doc-outline"></div>
        </aside>
    </div>
    <div id="editor-mount">
        <div class="loading-indicator"><div class="loading-bar"></div></div>
    </div>
</div>

<script>
    import { getDemoFs } from "../scripts/demo-fs";
    import { slideInDemo } from "../scripts/demo-anim";

    let editor: any = null;
    let mounting = false;

    async function mount() {
        const container = document.getElementById("editor-mount");
        if (!container) return;
        // Astro fires `astro:page-load` on the initial load too, so mount() is
        // invoked twice; this guard stops the second (concurrent) call from
        // racing past the async awaits below and creating a duplicate editor
        // (which would stack a second toolbar + outline as sibling chrome).
        if (mounting) return;
        mounting = true;
        try {
            if (editor) {
                try { editor.destroy(); } catch {}
                editor = null;
            }
            container.innerHTML = '<div class="loading-indicator"><div class="loading-bar"></div></div>';

            const fs = await getDemoFs();
            const { createEditor } = await import("@joinezco/markdown-editor");
            container.innerHTML = '';
            editor = createEditor({
                element: container,
                autofocus: false,
                fs: {
                    fs,
                    filepath: "hello.md",
                    // Debounced persistence: every edit writes back to
                    // the OPFS-backed demo filesystem after 500ms.
                    autoSave: true,
                },
                // Search field, mounted into the left gutter above the outline
                // (under the logo) rather than the default in-editor toolbar slot.
                toolbar: {
                    className: "ezweb-toolbar",
                    mount: () => document.getElementById("doc-toolbar"),
                },
                // Auto-generated document outline, mounted into the left gutter.
                // No visible title — the outline's purpose reads from context; the
                // package's `<nav aria-label="Document outline">` keeps it described.
                sidebar: { mount: () => document.getElementById("doc-outline") },
            });
            // Theme the whole `.ezco-mde` wrapper (not just the editable) so the
            // dark vars inherit to the chrome too — the toolbar slot + its search
            // dropdown live in the wrapper, and need the dark `--ezco-mde-context-
            // menu-*` values for legible (light) result text on the black surface.
            (editor.view.dom.closest(".ezco-mde") ?? editor.view.dom)
                .setAttribute("data-theme", "dark");
            // Expose for manual debugging / inspection in the dev preview.
            (window as any).editor = editor;
            slideInDemo(container);
        } finally {
            mounting = false;
        }
    }

    mount().catch(console.error);
    document.addEventListener("astro:page-load", () => {
        if (location.pathname.replace(/\/$/, "") === "/work/markdown-editor") {
            mount().catch(console.error);
        }
    });
    document.addEventListener("astro:before-swap", () => {
        if (editor) {
            try { editor.destroy(); } catch {}
            editor = null;
        }
    });
</script>

<style>
    @font-face {
        font-family: "Source Serif 4";
        src: url("/fonts/Source_Serif_4/SourceSerif4-VariableFont_opsz,wght.ttf") format("truetype-variations");
        font-weight: 200 900;
        font-style: normal;
    }

    @font-face {
        font-family: "Source Serif 4";
        src: url("/fonts/Source_Serif_4/SourceSerif4-Italic-VariableFont_opsz,wght.ttf") format("truetype-variations");
        font-weight: 200 900;
        font-style: italic;
    }

    #editor-mount :global(.ProseMirror) {
        font-family: 'Source Serif 4', system-ui, Avenir, Helvetica, Arial, serif;
    }

    /* Override codeblock CSS variables to make embedded code editors
       transparent. Needs higher specificity than the package's
       `[data-theme="dark"] .cm-editor` selector (0,2,0); the scoped
       `#editor-mount` adds an attribute selector to bring us to 1,3,0. */
    #editor-mount :global([data-theme="dark"] .cm-editor),
    #editor-mount :global(.cm-editor[data-theme="dark"]),
    #editor-mount :global([data-theme="dark"] .cm-toolbar-panel),
    #editor-mount :global(.cm-toolbar-panel[data-theme="dark"]) {
        --cm-background: transparent;
        --cm-gutter-background: #000000;
        --cm-line-highlight: transparent;
        --cm-toolbar-bg-dark: #000000;
        --cm-toolbar-bg-light: #000000;
        --cm-toolbar-background: #000000;
    }

    /* CodeMirror's baseTheme draws a focus outline on `.cm-editor.cm-focused`
       and a gray default background on `.cm-panels`. Suppress both. We
       do NOT clear `.cm-panel` here — CM adds that class to every
       panel-dom including our `.cm-toolbar-panel`, so wiping it would
       also wipe the toolbar's own background. */
    #editor-mount :global(.cm-editor.cm-focused) {
        outline: none;
    }
    #editor-mount :global(.cm-panels) {
        background: transparent;
    }

    #editor-mount :global(.cm-lineNumbers .cm-gutterElement) {
        padding: 0 3px 0 0px;
    }

    #editor-mount :global(.ezco-mde[data-theme="dark"]),
    #editor-mount :global([data-theme="dark"] .ezco-mde) {
        --ezco-mde-bg: transparent;
        --ezco-mde-code-bg: #ffffff;
        --ezco-mde-table-bg: transparent;
        --ezco-mde-base-font-size: 1.25rem;
        --cm-font-size: 1.25rem;
        /* In-wrapper chrome (the codeblock tooltips, the search dropdown) reads
           its border from this var; pin it to the page's menu border so those
           match the body-appended menus (block-action / selection) exactly. */
        --ezco-mde-context-menu-border: rgba(255, 255, 255, 0.12);
    }

    #editor-mount :global(.ezco-mde > :not(.cm-editor) code) {
        color: #1e1e1e;
        border-radius: 0px;
    }

    #editor-mount :global(.ezco-mde table) {
        border: none;
    }
    #editor-mount :global(.ezco-mde tr) {
        border-bottom: 1px solid var(--ezco-mde-code-bg-dark);
    }
    #editor-mount :global(.ezco-mde tr:last-child) {
        border-bottom: none;
    }
    #editor-mount :global(.ezco-mde th:first-child),
    #editor-mount :global(.ezco-mde td:first-child) {
        padding-left: 0;
    }

    #editor-mount :global(.cm-tooltip),
    #editor-mount :global(.cm-search-results) {
        background: #0a0a0a;
    }

    :global(.cm-context-menu[data-theme="dark"]) {
        background: #000000;
    }

    /* Color the body-appended menus (block-action, selection, link, slash
       commands) to the page's black+white palette. They live OUTSIDE the editor
       wrapper, so they take these `--ezco-mde-context-menu-*` vars from the page
       rather than the wrapper's charcoal dark theme — and a value set on `body`
       wins over the package's `:root`-level defaults for everything beneath it.
       The blue accent (selected/hovered row) is intentionally left in place. */
    :global(body) {
        --ezco-mde-context-menu-bg: #0a0a0a;
        --ezco-mde-context-menu-bg-hover: rgba(255, 255, 255, 0.08);
        --ezco-mde-context-menu-color: #f5f5f5;
        --ezco-mde-context-menu-border: rgba(255, 255, 255, 0.12);
        --ezco-mde-context-menu-item-bg-hover: rgba(255, 255, 255, 0.1);
        --ezco-mde-context-menu-item-color-muted: rgba(245, 245, 245, 0.55);
    }

    /* ── Search toolbar (`.ezweb-toolbar`): styled as a real search field —
       bordered, rounded, on a slightly raised surface — so it's obvious you can
       click and type into it (not a static label). It's mounted in the left
       gutter (`#doc-toolbar`) under the logo, so it fills that column's width.
       The triple class beats the package's `.cm-toolbar-panel .ezco-mde-toolbar`
       (0,2,0) defaults. ── */
    :global(.cm-toolbar-panel.ezco-mde-toolbar.ezweb-toolbar) {
        position: relative;
        /* Cancel the package toolbar's default sticky inset (`top: 8px`). */
        top: 0;
        z-index: 1;
        width: 100%;
        min-width: 0;
        max-width: none;
        box-sizing: border-box;
        margin: 0;
        height: 44px;
        display: flex;
        align-items: center;
        padding: 0 14px;
        /* Opaque (not the old translucent `rgba(255,255,255,.06)`): the outline
           slides up behind this field as it un-sticks on scroll, and a see-
           through surface let those rows show through. Solid, slightly-raised
           dark over the page's black keeps the field reading as a field. */
        background: #18181b;
        border: 1px solid rgba(255, 255, 255, 0.18);
        /* Square corners to match ezco-web's 0-radius aesthetic. */
        border-radius: 0;
        box-shadow: none;
        color: #e4e4e7;
        --ezco-mde-toolbar-font-size: 14px;
    }
    /* Let the field's input shrink to the gutter width instead of forcing
       overflow from its `size` attribute (the package grows it to fit content). */
    :global(.ezweb-toolbar .cm-toolbar-input) {
        color: #e4e4e7;
        min-width: 0;
        flex: 1 1 auto;
    }
    :global(.ezweb-toolbar .cm-toolbar-input::placeholder),
    :global(.ezweb-toolbar .cm-toolbar-state-icon) {
        color: rgba(228, 228, 231, 0.5);
    }
    /* Results dropdown — match the body-appended menus (block-action, selection,
       link). It lives inside the dark wrapper, whose `--ezco-mde-context-menu-*`
       differ from the page's, so hardcode the values those menus resolve to:
       opaque `#0a0a0a`, a `rgba(255,255,255,.12)` border, 6px radius, same shadow. */
    :global(.ezweb-toolbar .cm-search-results) {
        background: #0a0a0a;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 0;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.13), 0 1px 3px rgba(0, 0, 0, 0.07);
        margin-top: 8px;
    }

    /* ── Square aesthetic ────────────────────────────────────────────────────
       ezco-web uses 0-radius (square) borders throughout, so flatten the corners
       on every rounded markdown-editor + codeblock UI surface: dropdowns, menus,
       tooltips, autocomplete, popovers, the emoji grid, the slash menu, the
       outline links, and the codeblock settings controls. These are scoped to
       this page only (this component renders solely on /work/markdown-editor), and
       `!important` beats the libraries' StyleModule rules, which are injected at
       runtime (after this static stylesheet) and would otherwise win on order. ── */
    :global(.cm-tooltip),
    :global(.cm-tooltip-autocomplete > ul > li),
    :global(.cm-tooltip-autocomplete li),
    :global(.cm-search-results),
    :global(.cm-search-result),
    :global(.cm-context-menu),
    :global(.cm-settings-input),
    :global(.cm-settings-select),
    :global(.cm-settings-button),
    :global(.cm-settings-font-size-input),
    :global(.cm-toolbar-panel.ezco-mde-toolbar),
    :global(.ezco-mde-context-menu),
    :global(.ezco-mde-context-menu-item),
    :global(.ezco-mde-emoji-menu),
    :global(.ezco-mde-emoji-cell),
    :global(.ezco-mde-slash-menu),
    :global(.ezco-mde-slash-item),
    :global(.ezco-mde-slash-item-icon),
    :global(.ezco-mde-selection-menu-btn),
    :global(.ezco-mde-link-popover),
    :global(.ezco-mde-link-popover-btn),
    :global(.ezco-mde-link-popover-input),
    :global(.ezco-mde-sidebar-link),
    :global(.ezco-mde-sidebar-link code) {
        border-radius: 0 !important;
    }

    .demo-container {
        width: 100%;
        min-height: 70vh;
        display: flex;
        flex-direction: column;
        background-color: transparent;
        border: none;
        /* Positioning context for the absolute .outline-col (which spans this
           container's — i.e. the editor's — height). */
        position: relative;
    }

    /* The aside groups the gutter chrome (logo, search, outline) as flex children
       with gap spacing — no per-element `top` math. Sticky positioning + the
       height-spanning `.outline-col` (below) make the group scroll together and get
       pushed up by the footer. `pointer-events: auto` re-enables clicks the desktop
       column opts out of; `margin-bottom` spaces it from the editor on mobile,
       where the aside falls back to normal flow above the content. */
    .editor-aside {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 1rem;
        pointer-events: auto;
    }
    /* The aside's own logo shows only on desktop (the gutter, below); on narrower
       screens the layout's logo handles branding, so hide this one and let the
       aside fall back to just the search field at the top of the content. */
    .aside-logo {
        display: none;
    }
    /* `position: relative` + a z-index lifts the search field's results dropdown
       above the outline beneath it (the dropdown is wider than the column and
       spills down over the outline rows). */
    #doc-toolbar {
        position: relative;
        z-index: 1;
    }

    /* The outline lives OUTSIDE the editor and the page root has no
       data-theme, so set the dark theming vars locally. Hidden by default; on
       wide screens it floats in the left gutter (just left of the centered
       content column, like the fixed logo) so it reads as a left sidebar
       without stealing width from the editor. */
    #doc-outline {
        display: none;
        --ezco-mde-fg: #e4e4e7;
        --ezco-mde-accent: #2490e9;
        --ezco-mde-accent-fg: #ffffff;
        --ezco-mde-context-menu-item-color-muted: rgba(245, 245, 245, 0.5);
        --ezco-mde-context-menu-item-bg-hover: rgba(245, 245, 245, 0.08);
    }

    /* The outline reads in the document's serif (its content font) so the map
       matches the prose's voice; the library nav sets its own Inter font, so
       override it on the nav element itself. Also fit the nav to its container:
       the package default is a fixed 220px, which overflows the (narrower)
       #doc-outline and gets its rounded link corners clipped by the container's
       `overflow` — `width: 100%` plus a little right padding keeps the rounded
       links inside the clip box. */
    #doc-outline :global(.ezco-mde-sidebar) {
        font-family: 'Source Serif 4', system-ui, Avenir, Helvetica, Arial, serif;
        width: 100%;
        box-sizing: border-box;
    }
    /* Unselected inline code in the outline: the editor's `--ezco-mde-code-bg`
       doesn't reach out here (the outline lives outside the themed wrapper), so
       the package fallback renders as muted grey on translucent grey. Give it a
       legible surface + text. (The active row's own code style is left alone.) */
    #doc-outline :global(.ezco-mde-sidebar-link:not(.is-active) code) {
        background: rgba(255, 255, 255, 0.1);
        color: #e4e4e7;
    }

    /* On desktop the aside renders its own logo (top of the gutter group), so hide
       the layout's fixed logo there to avoid a duplicate. Below 1200px the aside
       shows only the search field and the layout's logo handles branding. */
    @media (min-width: 1200px) {
        /* `!important` to beat the layout's `.dual-col-page .logo-fixed` rule
           (higher specificity) — a deliberate per-page override of shared chrome. */
        :global(.logo-fixed) {
            display: none !important;
        }
    }

    @media (min-width: 1200px) {
        /* A left column spanning the editor's height. Absolutely positioned within
           the relative .demo-container, so `50%` resolves to the viewport centre —
           placing it in the left margin of the centred content. It bounds the
           sticky aside so the group scrolls away before the footer (rather than
           overlapping it) once the column's bottom is reached. */
        .outline-col {
            position: absolute;
            top: 0;
            bottom: 0;
            right: calc(50% + 356px);
            pointer-events: none;
            /* Shrink-wrap to content, clamped: `min-width` so the search never
               collapses on a heading-less doc (160px = the logo's width); a
               `max-width` so a long filepath/heading can't push the column off the
               left edge. */
            min-width: 160px;
            max-width: 220px;
            /* Lift the gutter chrome above the document so the search dropdown
               (wider than the column, spilling toward the content) paints over the
               prose. The column is transparent + click-through. */
            z-index: 30;
        }
        /* The whole group sticks at the logo's original top (2rem) and travels as a
           single unit — gap (above) handles the spacing between logo, search, and
           outline; `.outline-col`'s bottom pushes it up near the footer. */
        .editor-aside {
            position: sticky;
            top: 2rem;
        }
        /* Show the aside's own logo here (the layout's fixed logo is hidden). */
        .aside-logo {
            display: block;
        }
        #doc-outline {
            display: block;
            width: 100%;
        }
    }

    /* The editor flows at its natural height so the PAGE scrolls (no inner
       scroll pane). The search field and outline stick in the left gutter. */
    #editor-mount {
        display: block;
    }
    /* Pull the editor content toward the sidebar column to nearly close the gap
       between them. The section already adds 2rem of left padding (the space
       between the sidebar and the content), so a small negative margin here lands
       the editor just to the right of the outline. Only on desktop, where the
       outline column exists. */
    @media (min-width: 1024px) {
        #editor-mount {
            margin-left: -1.5rem;
        }
    }

    /* The search field now lives in the left gutter (see `#doc-toolbar`), so the
       in-editor toolbar slot is unused — the package hides it (`:empty`) and the
       document flows from the top with just a little breathing room. */
    #editor-mount :global(.ezco-mde-content) {}
    /* Anchor links (outline + heading ids) scroll via `scrollIntoView`, which
       honours `scroll-margin-top` — keep a small offset so a clicked anchor lands
       a touch below the viewport top rather than flush against it. */
    #editor-mount :global(.ezco-mde-body :is(h1, h2, h3, h4, h5, h6)) {
        scroll-margin-top: 2rem;
    }
    /* Give a short/empty document a full-height click target: the editable fills
       the viewport, so clicking the empty area places the caret (at the top, for
       an empty document) rather than only the text rows being live. */
    #editor-mount :global(.ezco-mde-body) {
        min-height: 60vh;
    }

    #editor-mount :global(.cm-editor),
    #editor-mount :global(table) {
        margin-bottom: 0;
    }

    .loading-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 1;
        min-height: 200px;
    }

    .loading-bar {
        width: 48px;
        height: 2px;
        background: #444;
        border-radius: 1px;
        animation: loading-pulse 1.5s ease-in-out infinite;
    }

    @keyframes loading-pulse {
        0%, 100% { opacity: 0.3; }
        50% { opacity: 1; }
    }
</style>
