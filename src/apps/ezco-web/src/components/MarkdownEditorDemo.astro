---
// The footer (slotted into `DualColumnLayout`'s `footer` slot) is
// rendered by the consuming page, not by this component — `slot`
// attributes only resolve against the *immediate* parent component's
// named slots, and `MarkdownEditorDemo` itself has no footer slot.
---

<div class="demo-container bg-[#1e1e1e]">
    <div id="doc-outline"></div>
    <div id="editor-mount">
        <div class="loading-indicator"><div class="loading-bar"></div></div>
    </div>
</div>

<script>
    import { getDemoFs } from "../scripts/demo-fs";
    import { slideInDemo } from "../scripts/demo-anim";

    let editor: any = null;
    let mounting = false;

    async function mount() {
        const container = document.getElementById("editor-mount");
        if (!container) return;
        // Astro fires `astro:page-load` on the initial load too, so mount() is
        // invoked twice; this guard stops the second (concurrent) call from
        // racing past the async awaits below and creating a duplicate editor
        // (which would stack a second toolbar + outline as sibling chrome).
        if (mounting) return;
        mounting = true;
        try {
            if (editor) {
                try { editor.destroy(); } catch {}
                editor = null;
            }
            container.innerHTML = '<div class="loading-indicator"><div class="loading-bar"></div></div>';

            const fs = await getDemoFs();
            const { createEditor } = await import("@joinezco/markdown-editor");
            container.innerHTML = '';
            editor = createEditor({
                element: container,
                autofocus: false,
                fs: {
                    fs,
                    filepath: "hello.md",
                    // Debounced persistence: every edit writes back to
                    // the OPFS-backed demo filesystem after 500ms.
                    autoSave: true,
                },
                // Static, full-width frosted search row (styled via `.ezweb-toolbar`).
                toolbar: { className: "ezweb-toolbar" },
                // Auto-generated document outline, mounted into the left gutter.
                sidebar: { mount: () => document.getElementById("doc-outline"), title: "Outline" },
            });
            editor.view.dom.setAttribute("data-theme", "dark");
            // Expose for manual debugging / inspection in the dev preview.
            (window as any).editor = editor;
            slideInDemo(container);
        } finally {
            mounting = false;
        }
    }

    mount().catch(console.error);
    document.addEventListener("astro:page-load", () => {
        if (location.pathname.replace(/\/$/, "") === "/work/markdown-editor") {
            mount().catch(console.error);
        }
    });
    document.addEventListener("astro:before-swap", () => {
        if (editor) {
            try { editor.destroy(); } catch {}
            editor = null;
        }
    });
</script>

<style>
    @font-face {
        font-family: "Source Serif 4";
        src: url("/fonts/Source_Serif_4/SourceSerif4-VariableFont_opsz,wght.ttf") format("truetype-variations");
        font-weight: 200 900;
        font-style: normal;
    }

    @font-face {
        font-family: "Source Serif 4";
        src: url("/fonts/Source_Serif_4/SourceSerif4-Italic-VariableFont_opsz,wght.ttf") format("truetype-variations");
        font-weight: 200 900;
        font-style: italic;
    }

    #editor-mount :global(.ProseMirror) {
        font-family: 'Source Serif 4', system-ui, Avenir, Helvetica, Arial, serif;
    }

    /* Override codeblock CSS variables to make embedded code editors
       transparent. Needs higher specificity than the package's
       `[data-theme="dark"] .cm-editor` selector (0,2,0); the scoped
       `#editor-mount` adds an attribute selector to bring us to 1,3,0. */
    #editor-mount :global([data-theme="dark"] .cm-editor),
    #editor-mount :global(.cm-editor[data-theme="dark"]),
    #editor-mount :global([data-theme="dark"] .cm-toolbar-panel),
    #editor-mount :global(.cm-toolbar-panel[data-theme="dark"]) {
        --cm-background: transparent;
        --cm-gutter-background: #000000;
        --cm-line-highlight: transparent;
        --cm-toolbar-bg-dark: #000000;
        --cm-toolbar-bg-light: #000000;
        --cm-toolbar-background: #000000;
    }

    /* CodeMirror's baseTheme draws a focus outline on `.cm-editor.cm-focused`
       and a gray default background on `.cm-panels`. Suppress both. We
       do NOT clear `.cm-panel` here — CM adds that class to every
       panel-dom including our `.cm-toolbar-panel`, so wiping it would
       also wipe the toolbar's own background. */
    #editor-mount :global(.cm-editor.cm-focused) {
        outline: none;
    }
    #editor-mount :global(.cm-panels) {
        background: transparent;
    }

    #editor-mount :global(.cm-lineNumbers .cm-gutterElement) {
        padding: 0 3px 0 0px;
    }

    #editor-mount :global(.ezco-mde[data-theme="dark"]),
    #editor-mount :global([data-theme="dark"] .ezco-mde) {
        --ezco-mde-bg: transparent;
        --ezco-mde-code-bg: #ffffff;
        --ezco-mde-table-bg: transparent;
        --ezco-mde-base-font-size: 1.25rem;
        --cm-font-size: 1.25rem;
    }

    #editor-mount :global(.ezco-mde > :not(.cm-editor) code) {
        color: #1e1e1e;
        border-radius: 0px;
    }

    #editor-mount :global(.ezco-mde table) {
        border: none;
    }
    #editor-mount :global(.ezco-mde tr) {
        border-bottom: 1px solid var(--ezco-mde-code-bg-dark);
    }
    #editor-mount :global(.ezco-mde tr:last-child) {
        border-bottom: none;
    }
    #editor-mount :global(.ezco-mde th:first-child),
    #editor-mount :global(.ezco-mde td:first-child) {
        padding-left: 0;
    }

    #editor-mount :global(.cm-tooltip),
    #editor-mount :global(.cm-search-results) {
        background: #000000;
    }

    :global(.cm-context-menu[data-theme="dark"]) {
        background: #000000;
    }

    /* ── Search toolbar (the markdown-editor's `.ezweb-toolbar`): a full-width,
       frosted sticky row that the editor content scrolls *behind* (the
       backdrop-filter blurs it through), replacing the default floating pill.
       A subtle black input + a matching dropdown keep it in the ezco-web
       palette. The triple class beats the package's `.cm-toolbar-panel
       .ezco-mde-toolbar` (0,2,0) defaults. ── */
    :global(.cm-toolbar-panel.ezco-mde-toolbar.ezweb-toolbar) {
        position: sticky;
        top: 0;
        z-index: 30;
        width: 100%;
        min-width: 0;
        max-width: none;
        box-sizing: border-box;
        margin: 0;
        padding: 12px 16px;
        background: rgba(12, 12, 12, 0.55);
        -webkit-backdrop-filter: blur(16px) saturate(1.3);
        backdrop-filter: blur(16px) saturate(1.3);
        border: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 0;
        box-shadow: none;
        color: #e4e4e7;
        --ezco-mde-toolbar-font-size: 14px;
    }
    :global(.ezweb-toolbar .cm-toolbar-input) {
        color: #e4e4e7;
    }
    :global(.ezweb-toolbar .cm-toolbar-input::placeholder),
    :global(.ezweb-toolbar .cm-toolbar-state-icon) {
        color: rgba(228, 228, 231, 0.5);
    }
    /* Results dropdown — subtle black, frosted, to match the row. */
    :global(.ezweb-toolbar .cm-search-results) {
        background: rgba(10, 10, 10, 0.9);
        -webkit-backdrop-filter: blur(16px);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
        margin-top: 8px;
    }

    .demo-container {
        width: 100%;
        min-height: 70vh;
        display: flex;
        flex-direction: column;
        background-color: transparent;
        border: none;
    }

    /* The outline lives OUTSIDE the editor and the page root has no
       data-theme, so set the dark theming vars locally. Hidden by default; on
       wide screens it floats in the left gutter (just left of the centered
       content column, like the fixed logo) so it reads as a left sidebar
       without stealing width from the editor. */
    #doc-outline {
        display: none;
        --ezco-mde-fg: #e4e4e7;
        --ezco-mde-accent: #2490e9;
        --ezco-mde-accent-fg: #ffffff;
        --ezco-mde-context-menu-item-color-muted: rgba(245, 245, 245, 0.5);
        --ezco-mde-context-menu-item-bg-hover: rgba(245, 245, 245, 0.08);
    }

    @media (min-width: 1200px) {
        #doc-outline {
            display: block;
            position: fixed;
            top: 9rem;
            /* The content column is ~648px wide and centered; sit just to its left. */
            right: calc(50% + 332px);
            width: 210px;
            max-height: calc(100vh - 11rem);
            overflow-y: auto;
        }
    }

    #editor-mount {
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    /* Narrow screens get every pixel of horizontal real estate; the
       left-side breathing room only kicks in once there's room to
       spare. Matches the `Layout.astro` desktop breakpoint so the
       gutter appears together with the fixed-aside logo column. */
    @media (min-width: 1024px) {
        #editor-mount {
            margin-left: 1rem;
        }
    }

    #editor-mount :global(.ezco-mde) {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    #editor-mount :global(.ProseMirror) {
        flex: 1;
    }

    #editor-mount :global(.cm-editor),
    #editor-mount :global(table) {
        margin-bottom: 0;
    }

    .loading-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 1;
        min-height: 200px;
    }

    .loading-bar {
        width: 48px;
        height: 2px;
        background: #444;
        border-radius: 1px;
        animation: loading-pulse 1.5s ease-in-out infinite;
    }

    @keyframes loading-pulse {
        0%, 100% { opacity: 0.3; }
        50% { opacity: 1; }
    }
</style>
