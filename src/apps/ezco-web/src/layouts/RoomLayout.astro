---
/* A bare document for the room: no page chrome, the room paints everything. */
import '../styles/global.css';
import '../styles/room.css';

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'ez co · the room',
	description = 'joinez.co is a room you walk into. The logo is the building; the furniture is the site.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
