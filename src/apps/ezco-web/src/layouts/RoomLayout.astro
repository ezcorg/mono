---
/* A bare document for the room: no page chrome, the room paints everything.
   A static page (src/pages/blog/*, about, …) passes `route`: the address is swapped for the room's hash route before the
   room boots, so the page opens on the thing it describes, and the static content underneath is what crawlers read. */
import '../styles/global.css';
import '../styles/room.css';
import { SITE, TAGLINE } from '../data/site';

export interface Props {
	title?: string;
	description?: string;
	/** the page's own address, e.g. `/blog/hello/` (the canonical one; the room's hash route is derived from it) */
	canonical?: string;
	/** the room route to open on, e.g. `#/blog/hello`; given only by static pages */
	route?: string;
	type?: 'website' | 'article';
	/** ISO date, articles only */
	published?: string;
	/** JSON-LD, serialised as is */
	jsonld?: object;
	/** the post's tags: kept for crawlers only, nothing renders them */
	keywords?: string[];
}

const { title = 'ez co', description = TAGLINE, canonical = '/', route, type = 'website', published, jsonld, keywords } = Astro.props;
const url = SITE + canonical;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={url} />
		<link rel="alternate" type="application/rss+xml" title="ez co · blog" href={SITE + '/blog/rss.xml'} />
		<title>{title}</title>
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="ez co" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={url} />
		<meta property="og:image" content={SITE + '/og.png'} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="ez co" />
		{published && <meta property="article:published_time" content={published} />}
		{keywords?.length && <meta name="keywords" content={keywords.join(', ')} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f5f5" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
		{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
		<script is:inline>document.documentElement.classList.add('js');try{const m=localStorage.getItem('ezco-lights')||'auto';if(m==='day'||(m==='auto'&&!matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('lit')}catch{}</script>
		{route && <script is:inline define:vars={{ route }}>history.replaceState(null, '', '/' + location.search + route);</script>}
	</head>
	<body>
		<slot />
	</body>
</html>
