use crate::exports::witmproxy::plugin::witm_plugin::{
    Capability, CapabilityProvider, ConfigureError, Event, Guest, GuestPlugin,
    Plugin as PluginResource, PluginError, PluginManifest, UserInput,
};
use crate::witmproxy::plugin::capabilities::{CapabilityKind, EventKind};

wit_bindgen::generate!({
    world: "witmproxy:plugin/plugin",
    generate_all
});

use crate::ezco::ezcap::types::Scope;

/// The host verifies the component's signature against this key before loading
/// it. `make` generates the keypair; `key.secret` must never be committed.
const PUBLIC_KEY_BYTES: &[u8] = include_bytes!("../key.public");

struct Component;

impl Guest for Component {
    type Plugin = PluginInstance;

    async fn manifest() -> PluginManifest {
        PluginManifest {
            name: "{{plugin-name}}".to_string(),
            namespace: "{{namespace}}".to_string(),
            author: "{{author}}".to_string(),
            version: "0.1.0".to_string(),
            description: "{{description}}".to_string(),
            license: "{{license}}".to_string(),
            url: "{{url}}".to_string(),
            publickey: PUBLIC_KEY_BYTES.to_vec(),
            metadata: vec![],

            // Capabilities you request. The user decides what is actually
            // granted, and may narrow any scope below -- so always handle the
            // case where a capability comes back as `None`.
            //
            // A scope is two CEL expressions (`ezco:ezcap/types.scope`).
            // `when` is evaluated by the host BEFORE this component is
            // instantiated, with the event bound: keep it as narrow as you
            // can, since a tight `when` lets the host skip instantiating the
            // plugin for events you do not care about — the single biggest
            // thing you can do for proxy throughput. `allow` is evaluated on
            // every call of a provider resource (logger, storage, clock) with
            // `call.method` and `call.args.*` bound; the user may narrow it,
            // and a refused call returns `Err(capability-error::denied)`.
            capabilities: vec![
                Capability {
                    kind: CapabilityKind::Logger,
                    scope: Scope {
                        when: "true".into(),
                        allow: "true".into(),
                    },
                },
                Capability {
                    kind: CapabilityKind::HandleEvent(EventKind::Request),
                    // Replace `"true"` with something specific, e.g.
                    //   "request.host() == 'example.com'"
                    //   "request.path().startsWith('/api/')"
                    scope: Scope {
                        when: "true".into(),
                        allow: "true".into(),
                    },
                },
            ],

            // User-facing configuration, rendered as a form in the web UI and
            // passed back to `create()` as `Vec<UserInput>`.
            configuration: vec![],
        }
    }
}

struct PluginInstance {
    _config: Vec<UserInput>,
}

impl GuestPlugin for PluginInstance {
    /// Called once per event, before `handle`, with the user's configuration.
    /// Return `Err(ConfigureError::InvalidInputs(..))` to reject bad config.
    async fn create(config: Vec<UserInput>) -> Result<PluginResource, ConfigureError> {
        Ok(PluginResource::new(PluginInstance { _config: config }))
    }

    /// Handle one event.
    ///
    /// * `Ok(Some(event))` continues the chain. Returning the event unchanged
    ///   is how you say "not for me".
    /// * `Ok(None)` terminates handling of this event entirely.
    /// * `Ok(Some(other_kind))` switches chains, where the host allows it:
    ///   a `Request` may return a `Response` to short-circuit the upstream
    ///   call. `Response` and `InboundContent` must return their own kind.
    /// * `Err(..)` reports that you could not handle the event. The host fails
    ///   the event closed and surfaces the reason to the operator -- you do
    ///   NOT need the `logger` capability to report a failure.
    ///
    /// The event carries lazy handles. If you do not read a body, nothing is
    /// read off the wire on your account -- so match narrowly and return early.
    async fn handle(
        &self,
        ev: Event,
        cap: CapabilityProvider,
    ) -> Result<Option<Event>, PluginError> {
        match ev {
            Event::Request(request) => {
                // Capabilities are optional: the user may not have granted it,
                // or may have scoped it away from this particular event. Say so
                // through the error channel rather than trapping.
                let Some(logger) = cap.logger().await else {
                    return Err(PluginError::CapabilityUnavailable(CapabilityKind::Logger));
                };
                // Every provider call is admitted against the capability's
                // `allow` scope; a refusal is an error value, never a trap.
                logger
                    .info("[{{plugin-name}}] saw a request".to_string())
                    .await
                    .map_err(|_| PluginError::CapabilityUnavailable(CapabilityKind::Logger))?;

                Ok(Some(Event::Request(request)))
            }

            // Pass every other event through untouched.
            other => Ok(Some(other)),
        }
    }
}

export!(Component);
