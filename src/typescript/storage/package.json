{
  "name": "@joinezco/storage",
  "version": "0.0.1",
  "description": "Folders of documents behind environment-agnostic interfaces: the VFS contract, its implementations (memory, Node, the browser's OPFS), and the indexes derived from a vault (links, full text).",
  "type": "module",
  "sideEffects": [
    "./dist/browser/*.worker.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.5",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.63.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "markdown-it": "^14.1.0",
    "minisearch": "^7.2.0"
  }
}
